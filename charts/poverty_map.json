{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "width": "container",
  "height": 370,
  "padding": 0,
  "projection": {
    "type": "mercator",
    "center": [109.3, 3.7],
    "scale": 2000
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dcebf7"
      }
    },
    {
      "data": {
        "url": "data/malaysia_map.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_graticules_1"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.45,
        "opacity": 0.45
      }
    },
    {
      "data": {
        "url": "data/malaysia_map.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.ADM0_A3 != 'MYS'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#d7d9dd",
        "stroke": "#90979f",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/malaysia_map.topojson",
        "format": {
          "type": "topojson",
          "feature": "malaysia.state"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.name",
          "as": "state"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/hh_poverty_state_2022.csv"
            },
            "key": "state",
            "fields": ["poverty_absolute", "poverty_hardcore", "poverty_relative"]
          }
        },
        {
          "calculate": "toNumber(datum.poverty_absolute)",
          "as": "poverty_absolute_num"
        },
        {
          "calculate": "datum.poverty_absolute_num < 2 ? 'Below 2%' : datum.poverty_absolute_num < 5 ? '2% to 4.9%' : datum.poverty_absolute_num < 8 ? '5% to 7.9%' : datum.poverty_absolute_num < 12 ? '8% to 11.9%' : '12% and above'",
          "as": "poverty_band"
        },
        {
          "calculate": "datum.poverty_absolute_num < 2 ? 1 : datum.poverty_absolute_num < 5 ? 2 : datum.poverty_absolute_num < 8 ? 3 : datum.poverty_absolute_num < 12 ? 4 : 5",
          "as": "poverty_band_order"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fffdf8",
        "strokeWidth": 1.1
      },
      "encoding": {
        "color": {
          "field": "poverty_band_order",
          "type": "ordinal",
          "title": "Absolute Poverty Rate Band",
          "scale": {
            "domain": [1, 2, 3, 4, 5],
            "range": ["#fff1dd", "#f6c78e", "#ec9a5e", "#d96b3b", "#b13c2e"]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "poverty_absolute_num",
            "type": "quantitative",
            "title": "Absolute Poverty (%)",
            "format": ".1f"
          },
          {
            "field": "poverty_hardcore",
            "type": "quantitative",
            "title": "Hardcore Poverty (%)",
            "format": ".1f"
          },
          {
            "field": "poverty_relative",
            "type": "quantitative",
            "title": "Relative Poverty (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "#fffdf8",
    "view": {
      "stroke": null
    }
  }
}
