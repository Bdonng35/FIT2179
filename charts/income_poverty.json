{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 420,
  "background": "#fffdf8",
  "data": {
    "url": "../data/hh_income_poverty_state.csv"
  },
  "transform": [
    {
      "filter": "datum.date == '2022-01-01'"
    },
    {
      "calculate": "toNumber(datum.income_median)",
      "as": "income_median_num"
    },
    {
      "calculate": "toNumber(datum.income_mean)",
      "as": "income_mean_num"
    },
    {
      "calculate": "toNumber(datum.poverty_absolute)",
      "as": "poverty_absolute_num"
    },
    {
      "calculate": "datum.income_median_num < 6338 && datum.poverty_absolute_num > 6.2 ? 'Lower income, higher poverty' : datum.income_median_num >= 6338 && datum.poverty_absolute_num > 6.2 ? 'Higher income, higher poverty' : datum.income_median_num < 6338 && datum.poverty_absolute_num <= 6.2 ? 'Lower income, lower poverty' : 'Higher income, lower poverty'",
      "as": "quadrant_group"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "income_ref": 6338
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#c8b8a2",
        "strokeDash": [5, 4],
        "strokeWidth": 1.3,
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "income_ref",
          "type": "quantitative",
          "title": "Median Household Income (RM), 2022"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 6338,
            "y": 20.7,
            "label": "National median income"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 8,
        "fontSize": 10.5,
        "fontWeight": "600",
        "color": "#8b7d69",
        "tooltip": false
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "poverty_ref": 6.2
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#c8b8a2",
        "strokeDash": [5, 4],
        "strokeWidth": 1.3,
        "opacity": 0.8
      },
      "encoding": {
        "y": {
          "field": "poverty_ref",
          "type": "quantitative",
          "title": "Absolute Poverty Rate (%), 2022"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 10250,
            "y": 6.2,
            "label": "National poverty rate"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -6,
        "fontSize": 10.5,
        "fontWeight": "600",
        "color": "#8b7d69",
        "tooltip": false
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 3600,
            "y": 18.0,
            "label": "Lower income,\nhigher poverty\n6 states"
          },
          {
            "x": 7950,
            "y": 18.0,
            "label": "Higher income,\nhigher poverty\nNo states"
          },
          {
            "x": 3600,
            "y": 1.6,
            "label": "Lower income,\nlower poverty\n4 states"
          },
          {
            "x": 7950,
            "y": 1.6,
            "label": "Higher income,\nlower poverty\n6 states"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 9.5,
        "fontWeight": "600",
        "lineBreak": "\n",
        "color": "#8b7d69",
        "opacity": 0.78,
        "tooltip": false
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "stroke": "#fffdf8",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "income_median_num",
          "type": "quantitative",
          "title": "Median Household Income (RM), 2022",
          "scale": {
            "domain": [3200, 11500]
          },
          "axis": {
            "format": ",.0f",
            "tickCount": 6,
            "grid": true
          }
        },
        "y": {
          "field": "poverty_absolute_num",
          "type": "quantitative",
          "title": "Absolute Poverty Rate (%), 2022",
          "scale": {
            "domain": [-0.5, 21]
          },
          "axis": {
            "format": ".0f",
            "tickCount": 6,
            "grid": true
          }
        },
        "size": {
          "value": 95
        },
        "opacity": {
          "value": 0.78
        },
        "color": {
          "field": "quadrant_group",
          "type": "nominal",
          "title": "State Group",
          "scale": {
            "domain": [
              "Lower income, higher poverty",
              "Higher income, higher poverty",
              "Lower income, lower poverty",
              "Higher income, lower poverty"
            ],
            "range": [
              "#c57a63",
              "#9c8b76",
              "#7f94b0",
              "#5f8577"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "columns": 2,
            "symbolType": "circle"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "income_median_num",
            "type": "quantitative",
            "title": "Median Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "income_mean_num",
            "type": "quantitative",
            "title": "Mean Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "poverty_absolute_num",
            "type": "quantitative",
            "title": "Absolute Poverty (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state != 'Putrajaya' && datum.state != 'Kuala Lumpur' && datum.state != 'Pulau Pinang' && datum.state != 'Perlis' && datum.state != 'Melaka' && datum.state != 'Pahang'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "600",
        "color": "#3a3a3a",
        "align": "center",
        "baseline": "bottom",
        "dy": -10
      },
      "encoding": {
        "x": {
          "field": "income_median_num",
          "type": "quantitative"
        },
        "y": {
          "field": "poverty_absolute_num",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Pulau Pinang' || datum.state == 'Perlis' || datum.state == 'Melaka'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "600",
        "color": "#3a3a3a",
        "align": "center",
        "baseline": "top",
        "dy": 8
      },
      "encoding": {
        "x": {
          "field": "income_median_num",
          "type": "quantitative"
        },
        "y": {
          "field": "poverty_absolute_num",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Kuala Lumpur'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "600",
        "color": "#3a3a3a",
        "align": "left",
        "baseline": "middle",
        "dx": 10
      },
      "encoding": {
        "x": {
          "field": "income_median_num",
          "type": "quantitative"
        },
        "y": {
          "field": "poverty_absolute_num",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Pahang'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "600",
        "color": "#3a3a3a",
        "align": "right",
        "baseline": "middle",
        "dx": -10
      },
      "encoding": {
        "x": {
          "field": "income_median_num",
          "type": "quantitative"
        },
        "y": {
          "field": "poverty_absolute_num",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Putrajaya'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "600",
        "color": "#3a3a3a",
        "align": "center",
        "baseline": "top",
        "dy": 8
      },
      "encoding": {
        "x": {
          "field": "income_median_num",
          "type": "quantitative"
        },
        "y": {
          "field": "poverty_absolute_num",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#333333",
      "titleColor": "#333333",
      "gridColor": "#d9e3ea"
    }
  }
}
