{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 420,
  "background": "#fffdf8",
  "data": {
    "url": "data/hh_income_poverty_state.csv"
  },
  "transform": [
    {
      "filter": "datum.date == '2022-01-01'"
    },
    {
      "calculate": "toNumber(datum.income_median)",
      "as": "income_median_num"
    },
    {
      "calculate": "toNumber(datum.income_mean)",
      "as": "income_mean_num"
    },
    {
      "calculate": "toNumber(datum.poverty_absolute)",
      "as": "poverty_absolute_num"
    },
    {
      "calculate": "datum.income_median_num < 6338 && datum.poverty_absolute_num > 6.2 ? 'Lower income, higher poverty' : datum.income_median_num >= 6338 && datum.poverty_absolute_num > 6.2 ? 'Higher income, higher poverty' : datum.income_median_num < 6338 && datum.poverty_absolute_num <= 6.2 ? 'Lower income, lower poverty' : 'Higher income, lower poverty'",
      "as": "quadrant_group"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "income_ref": 6338
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#c8b8a2",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.6,
        "opacity": 0.92
      },
      "encoding": {
        "x": {
          "field": "income_ref",
          "type": "quantitative",
          "title": "Median Household Income (RM), 2022"
        }
      }
    },
