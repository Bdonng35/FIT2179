{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "width": "container",
  "height": 370,
  "padding": 0,
  "projection": {
  "type": "mercator",
  "center": [109.3, 3.7],
  "scale": 2000
},
  "params": [
    {
      "name": "selectedState",
      "value": null
    }
  ],
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dcebf7"
      }
    },
    {
      "data": {
        "url": "data/malaysia_map.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_graticules_1"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.45,
        "opacity": 0.45
      }
    },
    {
      "data": {
        "url": "data/malaysia_map.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.ADM0_A3 != 'MYS'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#d7d9dd",
        "stroke": "#90979f",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/malaysia_map.topojson",
        "format": {
          "type": "topojson",
          "feature": "malaysia.state"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.name",
          "as": "state"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/hh_income_state.csv"
            },
            "key": "state",
            "fields": ["date", "income_median"]
          }
        },
        {
          "filter": "datum.date == '2022-01-01'"
        },
        {
          "calculate": "toNumber(datum.income_median)",
          "as": "income_median_num"
        },
        {
          "calculate": "datum.income_median_num < 4500 ? 'Below RM4,500' : datum.income_median_num < 5500 ? 'RM4,500 to RM5,499' : datum.income_median_num < 7000 ? 'RM5,500 to RM6,999' : datum.income_median_num < 9000 ? 'RM7,000 to RM8,999' : 'RM9,000 and above'",
          "as": "income_band"
        },
        {
          "calculate": "datum.income_median_num < 4500 ? 1 : datum.income_median_num < 5500 ? 2 : datum.income_median_num < 7000 ? 3 : datum.income_median_num < 9000 ? 4 : 5",
          "as": "income_band_order"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fffdf8",
        "strokeWidth": 1.1,
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "field": "income_band_order",
          "type": "ordinal",
          "title": "Median Household Income Band",
          "scale": {
            "domain": [1, 2, 3, 4, 5],
            "range": ["#f7edd8", "#e8c98b", "#d9a441", "#a9782f", "#6f4e1f"]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "selectedState === null || datum.state === selectedState",
            "value": 1
          },
          "value": 0.2
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "income_median_num",
            "type": "quantitative",
            "title": "Median Income (RM)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"label": "Kedah", "lon": 100, "lat": 6.15},
          {"label": "Kelantan", "lon": 101.3, "lat": 5.2},
          {"label": "Perak", "lon": 100.5, "lat": 4.8},
          {"label": "Selangor", "lon": 100.9, "lat": 3.88},
          {"label": "Kuala Lumpur", "lon": 101, "lat": 3.38},
          {"label": "Putrajaya", "lon": 101, "lat": 2.75}
        ]
      },
      "mark": {
        "type": "text",
        "font": "Poppins",
        "fontSize": 10,
        "fontWeight": 600,
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "color": "#000000",
        "strokeWidth": 0,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.label_tone === 'light'",
            "value": "#f6e3a1"
          },
          "value": "#000000"
        },
        "opacity": {
          "condition": {
            "test": "selectedState === null || datum.state === selectedState",
            "value": 1
          },
          "value": 0.18
        }
      }
    }
  ],
  "config": {
    "background": "#fffdf8",
    "view": {
      "stroke": null
    }
  }
}
