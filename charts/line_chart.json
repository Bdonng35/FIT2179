{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "National household mean and median income over time in Malaysia.",
    "width": 470,
    "height": 400,
    "data": {
        "url": "data/hh_income.csv"
    },
    "params": [
        {
            "name": "SelectedYear",
            "value": 2022
        }
    ],
    "transform": [
        {
            "fold": [
                "income_mean",
                "income_median"
            ],
            "as": [
                "income_type",
                "income_value"
            ]
        },
        {
            "calculate": "datum.income_type == 'income_mean' ? 'Mean Income' : 'Median Income'",
            "as": "income_label"
        },
        {
            "calculate": "year(toDate(datum.date))",
            "as": "year_num"
        },
        {
            "filter": "datum.year_num <= SelectedYear"
        }
    ],
    "encoding": {
        "x": {
            "field": "date",
            "type": "temporal",
            "title": "Year",
            "axis": {
                "format": "%Y",
                "labelAngle": 0
            }
        },
        "y": {
            "field": "income_value",
            "type": "quantitative",
            "title": "Household Income (RM)"
        },
        "color": {
            "field": "income_label",
            "type": "nominal",
            "title": "Income Measure",
            "scale": {
                "domain": [
                    "Mean Income",
                    "Median Income"
                ],
                "range": [
                    "#8c2f39",
                    "#d9a441"
                ]
            },
            "legend": {
                "orient": "none",
                "direction": "horizontal",
                "columns": 2,
                "legendX": 20,
                "legendY": 8,
                "labelFontSize": 13,
                "titleFontSize": 13
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "line",
                "strokeWidth": 3
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 76
            },
            "encoding": {
                "tooltip": [
                    {
                        "field": "year_num",
                        "type": "quantitative",
                        "title": "Year",
                        "format": "d"
                    },
                    {
                        "field": "income_label",
                        "type": "nominal",
                        "title": "Measure"
                    },
                    {
                        "field": "income_value",
                        "type": "quantitative",
                        "title": "Income (RM)",
                        "format": ",.0f"
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                    {
                        "min_year": 1997,
                        "note": "1997 Asian Financial Crisis:\nvisible income contraction"
                    }
                ]
            },
            "transform": [
                {
                    "filter": "SelectedYear >= datum.min_year"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "top",
                "fontSize": 10.5,
                "fontWeight": "600",
                "lineBreak": "\n",
                "tooltip": false
            },
            "encoding": {
                "x": {
                    "value": 20
                },
                "y": {
                    "value": 56
                },
                "text": {
                    "field": "note",
                    "type": "nominal"
                },
                "color": {
                    "value": "#5a4c34"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "min_year": 2020,
                        "note": "2020 COVID-19 downturn:\nrecovery was not immune\nto macro shocks"
                    }
                ]
            },
            "transform": [
                {
                    "filter": "SelectedYear >= datum.min_year"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "top",
                "fontSize": 10.5,
                "fontWeight": "600",
                "lineBreak": "\n",
                "tooltip": false
            },
            "encoding": {
                "x": {
                    "value": 20
                },
                "y": {
                    "value": 104
                },
                "text": {
                    "field": "note",
                    "type": "nominal"
                },
                "color": {
                    "value": "#5a4c34"
                }
            }
        }
    ],
    "config": {
        "background": "#fffdf8",
        "axis": {
            "labelFont": "Helvetica Neue",
            "titleFont": "Helvetica Neue",
            "gridColor": "#d9d2c3",
            "tickColor": "#d9d2c3",
            "domainColor": "#7a6f5f"
        },
        "legend": {
            "labelFont": "Helvetica Neue",
            "titleFont": "Helvetica Neue"
        }
    }
}