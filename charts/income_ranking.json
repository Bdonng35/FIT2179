{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 420,
  "data": {
    "url": "../data/hh_income_state.csv"
  },
  "transform": [
    {
      "filter": "datum.date == '2022-01-01'"
    },
    {
      "calculate": "toNumber(datum.income_median)",
      "as": "income_median_num"
    },
    {
      "calculate": "toNumber(datum.income_mean)",
      "as": "income_mean_num"
    },
    {
      "calculate": "datum.income_median_num < 4500 ? 'Below RM4,500' : datum.income_median_num < 5500 ? 'RM4,500 to RM5,499' : datum.income_median_num < 7000 ? 'RM5,500 to RM6,999' : datum.income_median_num < 9000 ? 'RM7,000 to RM8,999' : 'RM9,000 and above'",
      "as": "income_band"
    },
    {
      "calculate": "datum.income_median_num < 4500 ? 1 : datum.income_median_num < 5500 ? 2 : datum.income_median_num < 7000 ? 3 : datum.income_median_num < 9000 ? 4 : 5",
      "as": "income_band_order"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "ordinal",
      "sort": [
        "Kuala Lumpur",
        "Putrajaya",
        "Selangor",
        "Labuan",
        "Johor",
        "Pulau Pinang",
        "Melaka",
        "Terengganu",
        "Negeri Sembilan",
        "Sarawak",
        "Pahang",
        "Perlis",
        "Sabah",
        "Perak",
        "Kedah",
        "Kelantan"
      ],
      "title": null,
      "axis": {
        "labelLimit": 220,
        "labelFontSize": 12
      }
    },
    "x": {
      "field": "income_median_num",
      "type": "quantitative",
      "title": "Median Household Income (RM), 2022",
      "axis": {
        "format": ",.0f",
        "tickCount": 6,
        "grid": true
      }
    },
    "color": {
      "field": "income_band_order",
      "type": "ordinal",
      "scale": {
        "domain": [1, 2, 3, 4, 5],
        "range": ["#f7edd8", "#e8c98b", "#d9a441", "#a9782f", "#6f4e1f"]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "income_median_num",
        "type": "quantitative",
        "title": "Median Income (RM)",
        "format": ",.0f"
      },
      {
        "field": "income_mean_num",
        "type": "quantitative",
        "title": "Mean Income (RM)",
        "format": ",.0f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 11,
        "color": "#5c4520"
      },
      "encoding": {
        "text": {
          "field": "income_median_num",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "background": "#fffdf8",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#333333",
      "titleColor": "#333333",
      "gridColor": "#d9e3ea"
    }
  }
}
