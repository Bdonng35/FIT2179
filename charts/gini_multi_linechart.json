{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 430,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/hies_state.csv"
  },
  "params": [
    {
      "name": "FocusState",
      "value": "Selangor",
      "bind": {
        "input": "select",
        "options": [
          "Johor",
          "Kedah",
          "Kelantan",
          "Kuala Lumpur",
          "Labuan",
          "Melaka",
          "Negeri Sembilan",
          "Pahang",
          "Perak",
          "Perlis",
          "Pulau Pinang",
          "Putrajaya",
          "Sabah",
          "Sarawak",
          "Selangor",
          "Terengganu"
        ],
        "name": "State: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "year(toDate(datum.date))",
      "as": "year"
    },
    {
      "calculate": "toNumber(datum.gini)",
      "as": "gini_num"
    }
  ],
  "encoding": {},
  "layer": [
    {
      "mark": {
        "type": "line"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": [
              1974,
              2022
            ],
            "nice": false
          },
          "axis": {
            "values": [
              1974,
              1976,
              1979,
              1984,
              1987,
              1989,
              1992,
              1995,
              1997,
              1999,
              2002,
              2004,
              2007,
              2009,
              2012,
              2014,
              2016,
              2019,
              2022
            ],
            "labelAngle": 0,
            "labelFontSize": 11,
            "format": "d"
          }
        },
        "y": {
          "field": "gini_num",
          "type": "quantitative",
          "title": "Gini Coefficient",
          "scale": {
            "domain": [
              0.30,
              0.62
            ]
          },
          "axis": {
            "format": ".2f",
            "tickCount": 6,
            "grid": true
          }
        },
        "detail": {
          "field": "state"
        },
        "order": {
          "field": "year",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.state == FocusState",
            "value": "#2b6cb0"
          },
          "value": "#c7c7c7"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.state == FocusState",
            "value": 3.5
          },
          "value": 1.8
        },
        "opacity": {
          "condition": {
            "test": "datum.state == FocusState",
            "value": 1
          },
          "value": 0.25
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == FocusState"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 48,
        "stroke": "#fffdf8",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "gini_num",
          "type": "quantitative"
        },
        "detail": {
          "field": "state"
        },
        "color": {
          "value": "#2b6cb0"
        },
        "opacity": {
          "condition": {
            "test": "datum.state == FocusState",
            "value": 1
          },
          "value": 0.12
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "gini_num",
            "type": "quantitative",
            "title": "Gini",
            "format": ".3f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "#fffdf8",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#333333",
      "titleColor": "#333333",
      "gridColor": "#d9e3ea"
    },
    "legend": {
      "titleFont": "Helvetica Neue",
      "labelFont": "Helvetica Neue",
      "labelLimit": 180
    },
    "title": {
      "font": "Playfair Display",
      "fontSize": 20,
      "color": "#1f1f1f",
      "anchor": "start"
    }
  }
}
